---
/**
 * S3. Who is behind AI Wise, beside the only photograph of a person on the site.
 * The portrait has a subtle moss / warm-neutral color edit, at 2px radius.
 *
 * The text is a short bulleted list in both languages, from copy.ts. The Dutch
 * list is in Simon's own words.
 *
 * The portrait is art-directed rather than merely resized. Where the layout
 * stacks, below 768px, it is a 3:2 landscape frame across the full content
 * width, so it does not fill a phone screen on its own. From 768px it stands
 * beside the text as a 4:5 frame, in a column sized so its height stays close
 * to the height of the list. Measured values: docs/prd.md, R-S3.1.
 *
 * Both frames use assets/profile-picture-professional-harmonized.png, a
 * color-edited sibling of the preserved original, saved as JPEG masters (quality 90)
 * with sharp. The browser never downloads the original or pixels it would throw
 * away with object-fit.
 *   portrait-3x2-harmonized.jpg: left 204, top 0, 1074x716, resized to 1440x960.
 *   portrait-4x5-harmonized.jpg: left 413, top 0, 656x820, resized to 880x1100.
 * Both keep the face on the horizontal centre with the eyes near the upper third.
 */
import { getImage } from "astro:assets";
import landscape from "../assets/about/portrait-3x2-harmonized.jpg";
import upright from "../assets/about/portrait-4x5-harmonized.jpg";
import { COPY, type Lang } from "../content/copy";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = COPY[lang];

/* The media query that picks the upright frame. site.css switches the layout
   to two columns at the same width, so the two cannot drift apart. */
const UPRIGHT_MEDIA = "(min-width: 768px)";

/* Rendered widths, matching the grid columns in site.css. Below 768px the frame
   spans the container, which has 24px page margins on either side. */
const LANDSCAPE_SIZES = "calc(100vw - 48px)";
const UPRIGHT_SIZES = "200px";

const LANDSCAPE_WIDTHS = [480, 720, 960, 1440];
const UPRIGHT_WIDTHS = [200, 400, 600];

async function set(src: typeof landscape, widths: number[]) {
  const [avif, webp, jpg] = await Promise.all([
    getImage({ src, widths, format: "avif", quality: 60 }),
    getImage({ src, widths, format: "webp", quality: 76 }),
    getImage({ src, widths, format: "jpg", quality: 80 }),
  ]);
  return { avif, webp, jpg };
}

const land = await set(landscape, LANDSCAPE_WIDTHS);
const up = await set(upright, UPRIGHT_WIDTHS);
---

<section class="section" id="over" aria-labelledby="about-heading">
  <div class="aiw-container">
    <p class="aiw-eyebrow section__eyebrow">{t.about.eyebrow}</p>
    <h2 class="section__heading" id="about-heading">{t.about.heading}</h2>

    <div class="about__layout">
      <picture class="about__media">
        <source media={UPRIGHT_MEDIA} type="image/avif" srcset={up.avif.srcSet.attribute} sizes={UPRIGHT_SIZES} width={upright.width} height={upright.height} />
        <source media={UPRIGHT_MEDIA} type="image/webp" srcset={up.webp.srcSet.attribute} sizes={UPRIGHT_SIZES} width={upright.width} height={upright.height} />
        <source media={UPRIGHT_MEDIA} type="image/jpeg" srcset={up.jpg.srcSet.attribute} sizes={UPRIGHT_SIZES} width={upright.width} height={upright.height} />
        <source type="image/avif" srcset={land.avif.srcSet.attribute} sizes={LANDSCAPE_SIZES} />
        <source type="image/webp" srcset={land.webp.srcSet.attribute} sizes={LANDSCAPE_SIZES} />
        <img
          class="about__portrait"
          src={land.jpg.src}
          srcset={land.jpg.srcSet.attribute}
          sizes={LANDSCAPE_SIZES}
          alt={t.about.portraitAlt}
          width={landscape.width}
          height={landscape.height}
          loading="lazy"
          decoding="async"
        />
      </picture>

      <div class="section__body">
        <ul class="bullet-list">
          {t.about.points.map((point) => <li>{point}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
