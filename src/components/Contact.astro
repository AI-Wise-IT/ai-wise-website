---
/**
 * S4. A short invitation for anything that is not the scan, then the contact
 * form. Nothing else: the section is kept clean on purpose.
 *
 * The one centred section on the page, as its closing: heading, invitation and
 * form stand in one narrow column in the middle (site.css, "contact"). It has
 * no eyebrow label, because every other label lines up on the left edge and a
 * centred one would be the odd one out; the heading carries the section on its
 * own. Inside the form the fields and their text stay left-aligned.
 *
 * Experiment: on the seam with the section above, in place of a hairline, a
 * cord comes in from the right edge of the page, turns, and goes back out. It is
 * built from two of the design system's corner tiles, bottom-right A over
 * right-top B, so each strand keeps one colour and the two halves cross
 * opposite ways. Decorative only: aria-hidden, under the content. See site.css,
 * "contact cords".
 *
 * The form posts to Formward (forms.formward.eu), a form backend whose whole
 * processing chain stays in the EU: hosting in Sweden, mail through Mailjet in
 * France. Formward mails each submission to Simon. See docs/prd.md, S4 and R-J3.
 *
 * Name and email address are required; phone number and message are optional.
 * Without JavaScript it is a plain HTML form: it posts, and Formward redirects
 * to the thank-you page in the page's language (_redirect). With JavaScript two
 * things improve:
 *   - The message placeholder writes itself from what the visitor fills in
 *     ("Mail me op anna@bedrijf.nl"), and a message left empty is sent as that
 *     sentence, so a short message really is enough.
 *   - The form sends in the background and the thanks appear in its place.
 * The visitor's email address is copied into _replyto, so a reply goes to them.
 * _gotcha is Formward's honeypot: kept off screen and out of the tab order, a
 * person never fills it in, and a submission that has it is marked as spam.
 *
 * Name, email and phone carry an icon inside the field and their name as the
 * placeholder, on Simon's request; the label stays in the markup, visually
 * hidden, so every field keeps its accessible name. The message field has no
 * icon: its placeholder is the example sentence. A pencil in its bottom right
 * corner turns that sentence into the message itself, as a starting point to
 * edit. The pencil only shows while the field is empty, and only with
 * JavaScript, since without it there is nothing for it to do.
 *
 * The submit button is an outline button: the signal fill is kept for the
 * page's one action, booking a scan (R-V6).
 */
import Icon from "./Icon.astro";
import { COPY, type Lang } from "../content/copy";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = COPY[lang];
const f = t.contact.form;

const FORM_ENDPOINT ="https://forms.formward.eu/f/237b4807-6292-4fff-9a13-ed0ddd7be363";
const thanksUrl = new URL(f.thanksPath, Astro.site).href;
---

<section class="section contact" id="contact" aria-labelledby="contact-heading">
  <div class="contact__cords" aria-hidden="true">
    <div class="contact__cord contact__cord--in"></div>
    <div class="contact__cord contact__cord--out"></div>
  </div>
  <div class="aiw-container">
    <div class="contact__layout">
      <div class="contact__inner">
        <h2 class="section__heading contact__heading" id="contact-heading">{t.contact.heading}</h2>

        <div class="section__body contact__body">
          {t.contact.paragraphs.map((p) => <p class="aiw-body contact__intro">{p}</p>)}

          <form
            class="contact-form"
            action={FORM_ENDPOINT}
            method="post"
            data-placeholder={JSON.stringify(f.placeholder)}
            data-error={f.error}
            data-sending={f.sending}
          >
            <input type="hidden" name="_subject" value={f.subject} />
            <input type="hidden" name="_redirect" value={thanksUrl} />
            <input type="hidden" name="_replyto" value="" />
            <div class="contact-form__trap" aria-hidden="true">
              <label for="contact-gotcha">Laat dit veld leeg</label>
              <input id="contact-gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
            </div>

            <div class="field field--icon">
              <label class="visually-hidden" for="contact-name">{f.nameLabel}</label>
              <Icon name="user" size={18} class="field__icon" />
              <input
                class="field__control"
                id="contact-name"
                name="naam"
                type="text"
                autocomplete="name"
                placeholder={f.nameLabel}
                required
              />
            </div>

            <div class="contact-form__pair">
              <div class="field field--icon">
                <label class="visually-hidden" for="contact-email">{f.emailLabel}</label>
                <Icon name="mail" size={18} class="field__icon" />
                <input
                  class="field__control"
                  id="contact-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  placeholder={f.emailLabel}
                  required
                />
              </div>
              <div class="field field--icon">
                <label class="visually-hidden" for="contact-phone">{f.phoneLabel} ({f.optional})</label>
                <Icon name="phone" size={18} class="field__icon" />
                <input
                  class="field__control"
                  id="contact-phone"
                  name="telefoon"
                  type="tel"
                  autocomplete="tel"
                  placeholder={`${f.phoneLabel} (${f.optional})`}
                />
              </div>
            </div>

            <div class="field field--message">
              <label class="visually-hidden" for="contact-message">{f.messageLabel} ({f.optional})</label>
              <textarea
                class="field__control"
                id="contact-message"
                name="bericht"
                rows="5"
                placeholder={f.placeholder.start + f.placeholder.none}
              ></textarea>
              <button
                class="field__use-example"
                type="button"
                aria-label={f.useExample}
                title={f.useExample}
                aria-controls="contact-message"
                hidden
              >
                <Icon name="pencil" size={18} />
              </button>
            </div>

            <div class="contact-form__actions">
              <button class="btn btn--lg btn--outline-signal contact-form__submit" type="submit">{f.submit}</button>
            </div>
            <p class="contact-form__status" role="status" aria-live="polite"></p>
          </form>

          <div class="contact-form__done" hidden tabindex="-1">
            <p class="contact-form__done-heading">{f.successHeading}</p>
            <p class="aiw-body">{f.successText}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  type Placeholder = { start: string; none: string; email: string; phone: string; both: string };

  const form = document.querySelector<HTMLFormElement>(".contact-form");

  if (form) {
    const done = form.parentElement?.querySelector<HTMLElement>(".contact-form__done") ?? null;
    const status = form.querySelector<HTMLElement>(".contact-form__status");
    const email = form.querySelector<HTMLInputElement>("#contact-email");
    const phone = form.querySelector<HTMLInputElement>("#contact-phone");
    const message = form.querySelector<HTMLTextAreaElement>("#contact-message");
    const replyTo = form.querySelector<HTMLInputElement>('input[name="_replyto"]');
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const useExample = form.querySelector<HTMLButtonElement>(".field__use-example");
    const text: Placeholder = JSON.parse(form.dataset.placeholder ?? "{}");

    const sentence = (): string => {
      const e = email?.value.trim() ?? "";
      const p = phone?.value.trim() ?? "";
      const tail =
        e && p ? text.both : e ? text.email : p ? text.phone : text.none;
      return text.start + tail.replace("{email}", e).replace("{phone}", p);
    };

    const refresh = (): void => {
      if (message) message.placeholder = sentence();
      // The pencil only makes sense while the example is what the field shows.
      if (useExample && message) useExample.hidden = message.value.trim() !== "";
      if (replyTo && email) replyTo.value = email.validity.valid ? email.value.trim() : "";
    };

    email?.addEventListener("input", refresh);
    phone?.addEventListener("input", refresh);
    message?.addEventListener("input", refresh);
    refresh();

    // Take the example as the start of the message: the text lands in the field
    // with the cursor at its end, ready to be edited.
    useExample?.addEventListener("click", () => {
      if (!message) return;
      message.value = sentence();
      refresh();
      message.focus();
      message.setSelectionRange(message.value.length, message.value.length);
    });

    form.addEventListener("submit", async (event) => {
      refresh();
      if (!form.checkValidity()) {
        event.preventDefault();
        form.reportValidity();
        return;
      }
      if (message && !message.value.trim()) message.value = sentence();

      event.preventDefault();
      if (submit) submit.disabled = true;
      if (status) status.textContent = form.dataset.sending ?? "";

      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new URLSearchParams(
            [...new FormData(form)].map(([k, v]) => [k, String(v)]),
          ),
        });
        const result = (await response.json().catch(() => ({}))) as { ok?: boolean; error?: string };
        if (!response.ok || !result.ok) {
          // Formward says why in `error` (e.g. consent_required); keep it
          // findable in the console without showing it to the visitor.
          console.error("Contact form not sent:", response.status, result);
          throw new Error("not sent");
        }
        if (status) status.textContent = "";
        form.hidden = true;
        if (done) {
          done.hidden = false;
          done.focus();
        }
      } catch {
        if (status) status.textContent = form.dataset.error ?? "";
        if (submit) submit.disabled = false;
      }
    });
  }
</script>
