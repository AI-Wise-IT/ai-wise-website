---
/**
 * S4. Also carries the "who this is for": first anyone with something they want
 * built, then, after a short turning line, collaborators, one paragraph each for
 * developers and for designers and content writers. This is also where the site
 * says, positively, that AI Wise is young.
 *
 * The routes are three buttons: e-mail, LinkedIn (while set in COMPANY) and
 * WhatsApp. They use the blue outline variant (border and icon in signal blue,
 * label in the primary text colour), not a fill, because the design system
 * allows one signal fill per view and that is the hero's call to action. On wide
 * screens each button shows an icon and its name, side by side. On narrow
 * screens the names are hidden visually and the icons carry the buttons; the
 * names stay in the markup, so every button keeps its accessible name.
 *
 * LinkedIn and WhatsApp open in a new tab. Both carry a visually hidden hint
 * inside the label, so the accessible name reads "LinkedIn (opens in a new tab)"
 * on every width. The hint sits inside the label span rather than beside it, so
 * the space before it is ordinary inline text and never gets lost.
 */
import Icon from "./Icon.astro";
import { COMPANY, COPY, type Lang } from "../content/copy";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = COPY[lang];
const waHref = `https://wa.me/${COMPANY.whatsapp}?text=${encodeURIComponent(t.contact.whatsappPrefill)}`;
---

<section class="section" id="contact" aria-labelledby="contact-heading">
  <div class="aiw-container">
    <p class="aiw-eyebrow section__eyebrow">{t.contact.eyebrow}</p>
    <h2 class="section__heading" id="contact-heading">{t.contact.heading}</h2>

    <div class="section__body">
      {t.contact.paragraphs.map((p) => <p class="aiw-body">{p}</p>)}

      {t.contact.collaborationIntro && (
        <p class="aiw-body contact__turn">{t.contact.collaborationIntro}</p>
      )}
      {t.contact.collaboration?.map((p) => <p class="aiw-body">{p}</p>)}

      <div class="contact__actions">
        <a class="btn btn--md btn--outline-signal contact__action" href={`mailto:${COMPANY.email}`}>
          <Icon name="mail" size={22} />
          <span class="contact__action-label">{t.contact.emailLabel}</span>
        </a>
        {COMPANY.linkedin && (
          <a
            class="btn btn--md btn--outline-signal contact__action"
            href={COMPANY.linkedin}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="linkedin" size={22} />
            <span class="contact__action-label">{t.contact.linkedinLabel} <span class="visually-hidden">{t.nav.newTab}</span></span>
          </a>
        )}
        <a
          class="btn btn--md btn--outline-signal contact__action"
          href={waHref}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="whatsapp" size={22} />
          <span class="contact__action-label">{t.contact.whatsappLabel} <span class="visually-hidden">{t.nav.newTab}</span></span>
        </a>
      </div>

      <p class="contact__note">{t.contact.note}</p>
    </div>
  </div>
</section>
