---
/**
 * Inline SVG icons, drawn from Lucide (https://lucide.dev, ISC licence).
 *
 * The design system substitutes Lucide for an icon set the brand record leaves
 * undecided, and loads it from a CDN. A CDN is fine for a prototype and wrong
 * here: it adds a third-party request the privacy statement would have to name.
 * This site uses two icons, so the paths are inlined rather than pulling in a
 * package to tree-shake. Rules from the design system still hold: outline only,
 * stroke 1.5, currentColor, never larger than 32px, never replacing a word.
 */
interface Props {
  name: "arrow-right" | "message-circle";
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;

const PATHS: Record<Props["name"], string[]> = {
  "arrow-right": ["M5 12h14", "m12 5 7 7-7 7"],
  "message-circle": ["M7.9 20A9 9 0 1 0 4 16.1L2 22Z"],
};
---

<svg
  class:list={["icon", className]}
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {PATHS[name].map((d) => <path d={d} />)}
</svg>
