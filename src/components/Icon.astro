---
/**
 * Inline SVG icons.
 *
 * Sources:
 * - arrow-right: Lucide (https://lucide.dev), ISC licence.
 * - whatsapp, user, mail, phone, pencil: Tabler Icons 3.46.0, outline set
 *   (https://tabler.io/icons), MIT licence, Copyright (c) 2020-2026 Pawel Kuna.
 *   Lucide has no WhatsApp logo; the scan button and the floating WhatsApp
 *   button use it. user, mail, phone and pencil sit inside the contact form's fields,
 *   from the same set so they read as one family. Tabler's invisible 24x24
 *   bounding path is left out.
 *
 * The design system substitutes Lucide for an icon set the brand record leaves
 * undecided, and loads it from a CDN. A CDN is fine for a prototype and wrong
 * here: it adds a third-party request the privacy statement would have to name.
 * This site uses a handful of icons, so the paths are inlined rather than pulling
 * in a package. Every icon is drawn as an outline at stroke 1.5 in currentColor,
 * whichever set it comes from, so the two sources look alike.
 */
interface Props {
  name: "arrow-right" | "whatsapp" | "user" | "mail" | "phone" | "pencil";
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;

const PATHS: Record<Props["name"], string[]> = {
  "arrow-right": ["M5 12h14", "m12 5 7 7-7 7"],
  user: ["M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0", "M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"],
  mail: [
    "M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10",
    "M3 7l9 6l9 -6",
  ],
  phone: [
    "M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2",
  ],
  pencil: ["M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4", "M13.5 6.5l4 4"],
  whatsapp: [
    "M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9",
    "M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1",
  ],
};
---

<svg
  class:list={["icon", className]}
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {PATHS[name].map((d) => <path d={d} />)}
</svg>
