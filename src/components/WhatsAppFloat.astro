---
/**
 * S6. Persistent contact route, bottom right.
 *
 * The blue outline variant rather than a fill: the design system allows one
 * signal button per view and that is the hero call to action. No WhatsApp green
 * either, because the palette is four colours and green is not one of them.
 * Icon only, with the same Tabler WhatsApp logo as the contact button. What a
 * screen reader hears is the visually hidden text: the label from the copy
 * ("Message me on WhatsApp") and the hint that the link opens in a new tab.
 * Round, by Simon's choice; see site.css.
 *
 * The script below gets the button out of the way in two situations: while the
 * page is being scrolled, and once the reader has reached the contact buttons,
 * because those include a WhatsApp button of their own. "Reached" means the top
 * of the buttons is above the bottom edge of the window: they are in view, or
 * the page is scrolled past them towards the footer. Scrolling back up above
 * them brings the floating button back. The heading and the text of the contact
 * section come before the buttons, so the floating button is still there while
 * someone reads them. The script only toggles a class; the fades and the
 * non-interactive hidden state live in site.css (.wa-float--hidden).
 * Without JavaScript the button simply stays visible.
 */
import Icon from "./Icon.astro";
import { COMPANY, COPY, type Lang } from "../content/copy";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = COPY[lang];
const waHref = `https://wa.me/${COMPANY.whatsapp}?text=${encodeURIComponent(t.contact.whatsappPrefill)}`;
---

<a
  class="btn btn--outline-signal wa-float"
  href={waHref}
  target="_blank"
  rel="noopener noreferrer"
>
  <Icon name="whatsapp" size={24} />
  <span class="visually-hidden">{t.contact.whatsappFloatLabel} {t.nav.newTab}</span>
</a>

<script>
  const HIDDEN_CLASS = "wa-float--hidden";
  // How long the page must be still before the button fades back in.
  const SCROLL_IDLE_MS = 600;
  // Moving focus with Tab can scroll the page. Those scrolls are not the reader
  // scrolling, and hiding on them would drop the button out of the tab order
  // just as a keyboard user is about to reach it.
  const TAB_SCROLL_GRACE_MS = 250;

  const button = document.querySelector<HTMLAnchorElement>(".wa-float");

  if (button) {
    // Only the home pages have contact buttons; the privacy pages do not, and
    // there the button only steps aside while the page scrolls.
    const contactActions = document.querySelector<HTMLElement>(".contact__actions");
    let scrolling = false;
    let idleTimer: number | undefined;
    let lastTabAt = Number.NEGATIVE_INFINITY;

    // Keyboard focus only: a mouse click also focuses the link, and that should
    // not pin the button in place for the rest of the visit.
    const hasKeyboardFocus = (): boolean => {
      try {
        return button.matches(":focus-visible");
      } catch {
        return document.activeElement === button;
      }
    };

    // True while the contact buttons are in view and for everything below them,
    // down to the footer. Measured rather than remembered from the observer: a
    // jump straight from above the buttons to below them (the End key, a
    // restored scroll position) never makes them intersect, so the observer
    // alone would miss it.
    const reachedContactActions = (): boolean =>
      contactActions !== null && contactActions.getBoundingClientRect().top < window.innerHeight;

    const update = (): void => {
      // While scrolling the button is hidden anyway, so the position is only
      // measured once the page is still.
      const hide = (scrolling || reachedContactActions()) && !hasKeyboardFocus();
      button.classList.toggle(HIDDEN_CLASS, hide);
    };

    // The observer catches the buttons coming into or leaving view without a
    // scroll the handler below counts, such as a scroll caused by moving focus
    // with Tab. Its first callback also sets the state on page load.
    if (contactActions && "IntersectionObserver" in window) {
      new IntersectionObserver(update).observe(contactActions);
    }

    window.addEventListener("keydown", (event) => {
      if (event.key === "Tab") lastTabAt = performance.now();
    });

    window.addEventListener(
      "scroll",
      () => {
        if (performance.now() - lastTabAt < TAB_SCROLL_GRACE_MS) return;
        scrolling = true;
        update();
        window.clearTimeout(idleTimer);
        idleTimer = window.setTimeout(() => {
          scrolling = false;
          update();
        }, SCROLL_IDLE_MS);
      },
      { passive: true },
    );

    window.addEventListener("resize", update, { passive: true });

    // Re-evaluate when focus arrives or leaves, so a focused button is shown and
    // a button that loses focus while it should be hidden fades out.
    button.addEventListener("focus", update);
    button.addEventListener("blur", update);
  }
</script>
