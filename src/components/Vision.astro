---
/**
 * S2. The examples come first, so a reader sees something concrete to recognise
 * before the general text. The vision beside them describes the shift: what
 * used to be a large project is now within reach, also for small businesses
 * doing meaningful work. It stays general; the examples do the concrete work.
 * AI appears as the reason this is possible, not as the subject. It makes no
 * offer; the scan section after it does.
 */
import { COPY, type Lang } from "../content/copy";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = COPY[lang];
---

<section class="section" id="visie" aria-labelledby="vision-heading">
  <div class="aiw-container">
    <p class="aiw-eyebrow section__eyebrow">{t.vision.eyebrow}</p>

    {/* Three blocks on one grid, in reading order for narrow screens: the
        heading, the examples, the vision. Below 1024px they stack in that
        order, so the frame never stands without a heading above it. From 1024px
        the examples take the left column over the full height and the heading
        and the vision stack on the right, the heading level with the top of the
        frame. Each column lands at roughly 58 characters, inside the 68 the
        design system sets as the reading measure. See site.css, "vision". */}
    <div class="vision__layout">
      <h2 class="section__heading vision__heading" id="vision-heading">{t.vision.heading}</h2>

      {/* Possibilities, to give the reader something concrete to react to. One
          list in one frame that sets it apart from the vision; not a grid of
          tiles, which would read as a menu of services. See docs/prd.md, R-S2.3.
          The intro line only shows beside the vision; stacked under the heading
          the list needs no introduction. */}
      <div class="vision__examples card">
        <p class="aiw-body vision__examples-intro">{t.vision.examplesIntro}</p>
        <ul class="bullet-list vision__examples-list">
          {t.vision.examples.map((e) => <li>{e}</li>)}
        </ul>
      </div>

      <div class="section__body vision__text">
        {t.vision.paragraphs.map((p) => <p class="aiw-body">{p}</p>)}
      </div>
    </div>
  </div>
</section>
