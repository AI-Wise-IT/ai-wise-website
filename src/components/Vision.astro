---
/**
 * S2. The vision describes the shift: what used to be a large project is now
 * within reach, also for small practices doing meaningful work. It stays
 * general; the examples beside it do the concrete work. AI appears as the reason
 * this is possible, not as the subject. It makes no offer.
 *
 * The one Reflection on the page closes the vision, as a question the reader
 * leaves with. It is also the only place Newsreader appears.
 */
import { COPY, type Lang } from "../content/copy";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = COPY[lang];
---

<section class="section" id="visie" aria-labelledby="vision-heading">
  <div class="aiw-container">
    {/* Two blocks side by side from 1024px up: the vision on the left, what it
        can look like in practice on the right. The label and heading belong to
        the left block, so the frame on the right starts level with the label.
        Below 1024px they stack, vision first. Each column lands at roughly 58
        characters, inside the 68 the design system sets as the reading measure. */}
    <div class="vision__layout">
      <div class="section__body">
        <p class="aiw-eyebrow section__eyebrow">{t.vision.eyebrow}</p>
        <h2 class="section__heading" id="vision-heading">{t.vision.heading}</h2>

        {t.vision.paragraphs.map((p) => <p class="aiw-body">{p}</p>)}

        <p class="aiw-reflective vision__reflection">{t.vision.reflection}</p>
      </div>

      {/* Possibilities, to give the reader something concrete to react to. One
          list in one frame that sets it apart from the vision; not a grid of
          tiles, which would read as a menu of services. See docs/prd.md, R-S2.3. */}
      <div class="vision__examples card">
        <p class="aiw-body vision__examples-intro">{t.vision.examplesIntro}</p>
        <ul class="vision__examples-list">
          {t.vision.examples.map((e) => <li>{e}</li>)}
        </ul>
        {t.vision.examplesNote && <p class="aiw-body vision__examples-note">{t.vision.examplesNote}</p>}
      </div>
    </div>
  </div>
</section>
