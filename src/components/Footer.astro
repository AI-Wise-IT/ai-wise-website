---
/**
 * S5. Structure follows the design system's Chrome.Footer, with the page column
 * replaced by the company details the Dutch information duty asks for
 * (art. 3:15d BW): trade name, Chamber of Commerce number, VAT identification
 * number, contact details and place of business.
 */
import { COMPANY, COPY, path, type Lang } from "../content/copy";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = COPY[lang];
---

<footer class="site-footer">
  <div class="aiw-container site-footer__grid">
    <div>
      <img
        class="site-footer__lockup"
        src="/assets/logo/lockup-en-plain.svg"
        alt={`${COMPANY.name}, ${COMPANY.tagline}`}
        height="44"
      />
      <p class="site-footer__blurb">{t.footer.blurb}</p>
    </div>

    <div>
      <p class="aiw-eyebrow site-footer__col-title">{t.footer.directTitle}</p>
      <div class="site-footer__list">
        <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>
        <a href={`tel:${COMPANY.phoneIntl}`}>{COMPANY.phoneDisplay}</a>
      </div>
    </div>

    <div>
      <p class="aiw-eyebrow site-footer__col-title">{t.footer.legalTitle}</p>
      <div class="site-footer__list">
        <span class="site-footer__legal">{t.footer.kvkLabel} {COMPANY.kvk}</span>
        <span class="site-footer__legal">{t.footer.vatLabel} {COMPANY.vat}</span>
        <span class="site-footer__legal">{COMPANY.city}</span>
        <a href={path(lang, "privacy")}>{t.footer.privacy}</a>
      </div>
    </div>
  </div>

  <div class="aiw-container site-footer__baseline">
    <hr />
    <p class="site-footer__tagline">
      <span lang="en">{COMPANY.tagline}</span> &nbsp;·&nbsp; {COMPANY.owner}
    </p>
  </div>
</footer>
