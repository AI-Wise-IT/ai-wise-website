---
/**
 * S5. Structure follows the design system's Chrome.Footer, with the page column
 * replaced by the company details the Dutch information duty asks for
 * (art. 3:15d BW): trade name, Chamber of Commerce number, VAT identification
 * number, contact details and place of business.
 *
 * The logo is composed the way lockup-en.svg composes it: the glyph on the left,
 * as tall as the block beside it, and the wordmark with the tagline underneath.
 * The glyph and wordmark are the inlined logo files (LogoSvg.astro); the tagline
 * is live text, so it stays readable at a size a whole lockup image cannot give
 * it. The glyph carries the accessible name "AI Wise" and the wordmark is
 * decorative, so the name is read once and the tagline once, as the text it is.
 *
 * The line under the rule is a copyright notice. The year is the build year, and
 * the line is the same in both languages.
 */
import LogoSvg from "./LogoSvg.astro";
import { COMPANY, COPY, path, type Lang } from "../content/copy";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = COPY[lang];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="aiw-container site-footer__grid">
    <div>
      <div class="site-footer__lockup">
        <LogoSvg file="glyph.svg" class="site-footer__glyph" label={COMPANY.name} />
        <LogoSvg file="wordmark.svg" class="site-footer__wordmark" trimMargin />
        <p class="site-footer__tagline" lang="en">{COMPANY.tagline}</p>
      </div>
      <p class="site-footer__blurb">{t.footer.blurb}</p>
    </div>

    <div>
      <p class="aiw-eyebrow site-footer__col-title">{t.footer.directTitle}</p>
      <div class="site-footer__list">
        <a class="site-footer__link" href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>
        <a class="site-footer__link" href={`tel:${COMPANY.phoneIntl}`}>{COMPANY.phoneDisplay}</a>
      </div>
    </div>

    <div>
      <p class="aiw-eyebrow site-footer__col-title">{t.footer.legalTitle}</p>
      <div class="site-footer__list">
        <span class="site-footer__legal">{t.footer.kvkLabel} {COMPANY.kvk}</span>
        <span class="site-footer__legal">{t.footer.vatLabel} {COMPANY.vat}</span>
        <span class="site-footer__legal">{COMPANY.city}</span>
        <a class="site-footer__link" href={path(lang, "privacy")}>{t.footer.privacy}</a>
      </div>
    </div>
  </div>

  <div class="aiw-container site-footer__baseline">
    <hr />
    <p class="site-footer__copyright">© {year} {COMPANY.name}</p>
  </div>
</footer>
