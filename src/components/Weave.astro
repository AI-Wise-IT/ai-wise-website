---
/**
 * The weave. One placement per page, never repeated, near-black surfaces only.
 *
 * The arithmetic lives in the design system's base.css: the master is scaled so
 * its short edge matches the surface's short edge, which puts the strand at
 * exactly 5.2% of that edge, and the surface then crops it. This component only
 * chooses the master.
 *
 * Where along the surface the cord sits is set in CSS by whoever places it, via
 * the --aiw-weave-x and --aiw-weave-rotate custom properties. That is deliberate
 * and not merely a style preference: placement changes per breakpoint, which a
 * component prop cannot express, and the site's Content-Security-Policy hashes
 * stylesheets rather than style attributes, so an inline style would be blocked.
 * See site.css, .hero__weave.
 *
 * Decorative. It carries no meaning a screen reader needs, and it must never sit
 * behind text, so it is hidden from the accessibility tree.
 */
interface Props {
  shape?: "calm-drift" | "close-cord" | "strong-drift" | "held-right";
  class?: string;
}

const { shape = "held-right", class: className } = Astro.props;
---

<div class:list={["aiw-weave", `aiw-weave--${shape}`, className]} aria-hidden="true">
  <div class="aiw-weave__cord"></div>
</div>
