---
/**
 * S0. Glyph plus wordmark on the left, language switch on the right, nothing
 * else. Four sections do not need navigation, and the design system permits
 * exactly one sticky element on a site: this one.
 *
 * On the home page the header lies over the hero photograph: transparent at the
 * top of the page, solid near-black with its hairline once the page scrolls.
 * That switch is pure CSS (a scroll-driven animation, see site.css) and is
 * written so that a browser without support keeps the solid header.
 *
 * The glyph and wordmark are inlined from assets/logo/ rather than referenced
 * as <img>, without the near-black backing rectangle both files paint, which
 * would show as a dark box over the photograph. See LogoSvg.astro. Both are
 * decorative here; the link around them carries the accessible name.
 */
import LogoSvg from "./LogoSvg.astro";
import { COPY, path, type Lang } from "../content/copy";

interface Props {
  lang: Lang;
  page: "home" | "privacy";
}

const { lang, page } = Astro.props;
const t = COPY[lang];

/* Only the home page has a hero photograph to lie over. */
const overHero = page === "home";
---

<header class:list={["site-header", { "site-header--over-hero": overHero }]}>
  <div class="aiw-container site-header__inner">
    <a class="site-header__brand" href={path(lang, "home")} aria-label={t.nav.home}>
      <LogoSvg file="glyph.svg" class="site-header__glyph" />
      <LogoSvg file="wordmark.svg" class="site-header__wordmark" />
    </a>

    <nav class="lang-switch" aria-label={t.nav.language}>
      <a href={path("nl", page)} hreflang="nl" lang="nl" aria-current={lang === "nl" ? "true" : undefined}>NL</a>
      <span class="lang-switch__sep" aria-hidden="true">/</span>
      <a href={path("en", page)} hreflang="en" lang="en" aria-current={lang === "en" ? "true" : undefined}>EN</a>
    </nav>
  </div>
</header>
